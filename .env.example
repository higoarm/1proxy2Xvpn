# =============================================================================
# .env.example — Copy to .env and customize
# =============================================================================

# ── Image settings ────────────────────────────────────────────────────────────
IMAGE_NAME=1proxy2xvpn
IMAGE_TAG=latest

# ── Network ports ─────────────────────────────────────────────────────────────
# Each container occupies one port from BASE_PORT for HTTP and BASE_PORT+10000 for SOCKS5.
BASE_PORT=20000

# HAProxy frontends
HAPROXY_FRONTEND_PORT=9999     # HTTP load balancer
HAPROXY_SOCKS_PORT=9998        # SOCKS5 load balancer
HAPROXY_STATS_PORT=9997        # Stats panel (bound to 127.0.0.1 by default)

# ── Paths ─────────────────────────────────────────────────────────────────────
# Override only if .ovpn or auth files live outside the project tree.
OVPN_DIR=./ovpns
SECRETS_DIR=./secrets

# ── Container behavior ────────────────────────────────────────────────────────
ENABLE_SOCKS5=true             # SOCKS5 enabled by default. Set false to disable it
                               # (most workloads use the HTTP proxy on :9999).
                               # Saves ~3MB + 1 process per container at scale.
BATCH_SIZE=10                  # How many containers to start per batch
BATCH_DELAY=5                  # Seconds to pause between batches
TUN_WAIT_TIMEOUT=90            # Max seconds to wait for tun0 to appear
MONITOR_INTERVAL=30            # Seconds between in-container process-health checks.
                               # 30s is plenty; lower values just burn CPU ×N containers.

# ── Observability (only used when running `1proxy2xvpn observability up`) ────
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme       # CHANGE THIS before exposing Grafana

# ── Smart router (middleware) ────────────────────────────────────────────────
SMART_ROUTER_LISTEN=0.0.0.0:9888
SMART_ROUTER_UPSTREAM=http://127.0.0.1:9999

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
